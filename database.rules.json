{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "players": {
          "$id": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 14" }
          }
        },
        "scores": {
          "$hole": {
            "$id": {
              "strokes": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" }
            }
          }
        }
      }
    }
  }
}
